# Copy to .env and fill in. With no API key the app runs in offline "demo" mode.

# OpenAI-compatible endpoint (same variables as the main branch). NVIDIA defaults:
LLM_BASE_URL=https://integrate.api.nvidia.com/v1
LLM_MODEL=nvidia/nemotron-3.5-super-vl-120b-a12b
NVIDIA_API_KEY=
# LLM_API_KEY= / OPENAI_API_KEY= are also accepted.

# Extra JSON merged into every chat request. For Nemotron this turns off silent reasoning so
# answer tokens start streaming in ~1 s instead of ~15 s. Remove it for api.openai.com.
LLM_EXTRA_BODY={"chat_template_kwargs":{"enable_thinking":false}}

# auto (default: ai if a key is set, else demo) | ai | demo
LLM_PROVIDER=auto

# Retrieval
SEARCH_TOP_K=3
MAX_PASSAGES=8

# Pace of the offline demo model, in ms per word
DEMO_TOKEN_DELAY_MS=30

# Host port for docker compose
PORT=3000
